# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
tf.plan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
.terraform.lock.hcl

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets and local config
.env
.env.*
!.env.example

# Embedding cache - regenerable, and large
.cache/

# Eval output. Baselines ARE committed (they are the gate); run reports are not.
eval/reports/*
!eval/reports/.gitkeep

# macOS
.DS_Store

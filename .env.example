# cp .env.example .env, then fill from Terraform:
#   cd infra/envs/dev && terraform output -json app_env | jq -r \
#     'to_entries[] | "\(.key)=\(.value)"' > ../../../.env
#
# Or just: make env
#
# None of these is a secret. Authentication is your `az login` locally and the
# container's managed identity in Azure - there is no key to put in this file.

SEARCH_ENDPOINT=https://srch-rag-xxxxxx.search.windows.net
SEARCH_INDEX_NAME=corpus-v1

FOUNDRY_ENDPOINT=https://fdy-rag-xxxxxx.cognitiveservices.azure.com/
CHAT_DEPLOYMENT=gpt-4-1-mini
EMBEDDING_DEPLOYMENT=text-embedding-3-small

BLOB_ENDPOINT=https://stragxxxxxx.blob.core.windows.net
BLOB_CONTAINER=corpus

# Leave empty locally. Terraform sets it in the container so
# DefaultAzureCredential picks the right managed identity.
AZURE_CLIENT_ID=
